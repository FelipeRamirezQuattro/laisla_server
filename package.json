{
  "name": "la-isla-cafe-backend",
  "version": "1.0.0",
  "description": "Backend para La Isla Cafe - Cafetería de Especialidad",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop la-isla-cafe-backend",
    "pm2:logs": "pm2 logs la-isla-cafe-backend",
    "seed": "ts-node src/seed.ts",
    "seed:costs": "ts-node src/costs/seed/costsSeed.ts",
    "seed:inventario": "ts-node src/inventario/seed/inventarioSeed.ts",
    "seed:projects": "ts-node src/seed/seedProjects.ts",
    "seed:fiscal": "ts-node src/fiscal/seed/fiscalConfigSeed.ts",
    "seed:printing": "ts-node src/printing/seed/printingSeed.ts",
    "migrate:cash-shifts": "ts-node src/scripts/migrateCashClosingsToShifts.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "handlebars": "^4.7.9",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
