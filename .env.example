PORT=4000
NODE_ENV=production

# MongoDB Atlas production example:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/la-isla-cafe?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/la-isla-cafe

# Generate a long random value for production.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origins allowed by CORS. Use comma-separated values if needed.
CORS_ORIGIN=https://laislacafepicnic.com,https://www.laislacafepicnic.com

# API prefixes mounted by this backend. Use /api-filereport if the shared server
# routes that path to this app.
API_BASE_PATHS=/api,/api-filereport

# Google OAuth. Use the same OAuth Web Client ID in frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production example: https://your-domain.com/api/public/gmail/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:4000/api/public/gmail/callback
# Public URL of the deployed frontend. MUST be set to the real domain in
# production (e.g. https://laislacafepicnic.com) — used to build absolute
# image URLs in outgoing emails (logo, etc.) and as the redirect target
# after the Gmail OAuth consent screen. Left as localhost, emails ship with
# a dead logo link and the Gmail reconnect flow redirects to localhost.
FRONTEND_URL=http://localhost:5173

# Fallback shared Gmail SMTP account used when no authenticated user has connected Gmail.
# EMAIL_FROM/EMAIL_PASSWORD are the actual Gmail login (address + app
# password) that authenticates with smtp.gmail.com.
EMAIL_FROM=
EMAIL_PASSWORD=
# Optional: if the Gmail account above has a verified "Send mail as" alias
# (Gmail settings > Accounts > Send mail as), set this to that address to
# show it as the From/Reply-To instead of EMAIL_FROM. Left empty, EMAIL_FROM
# is used for both login and the visible sender address.
EMAIL_DISPLAY_FROM=
EMAIL_LOG_ONLY=true

# Cloudflare Turnstile secret key, used to verify the public newsletter
# subscribe form server-side. Get it from the Cloudflare dashboard (Turnstile
# widget). The matching site key goes in frontend/.env as
# VITE_TURNSTILE_SITE_KEY. Left empty, verification is skipped (local dev
# without a Cloudflare account) — set it in production.
TURNSTILE_SECRET_KEY=

# Electronic invoicing (DIAN) — decoupled fiscal layer. MOCK is safe for all
# local/dev/test work; real providers are wired in a later phase. Left as
# MOCK, no external network calls are ever made by this module.
EINVOICE_PROVIDER=MOCK

# Alanube (Alegra BaaS) REST credentials. TODO(provider-docs): confirm auth
# scheme, base URL per environment (test vs production), and required
# headers. Left empty, Alanube cannot be selected (getProvider throws).
EINVOICE_ALANUBE_API_KEY=
EINVOICE_ALANUBE_BASE_URL=

# Bilidox/Grafosoft REST + JWT credentials. TODO(provider-docs): confirm
# token endpoint, client id/secret shape, and refresh flow. Left empty,
# Bilidox cannot be selected (getProvider throws).
EINVOICE_BILIDOX_API_KEY=
EINVOICE_BILIDOX_BASE_URL=
EINVOICE_BILIDOX_CLIENT_ID=

# Thermal printing module (ticket de caja / comandas). PRINT_JOB_CLAIM_TIMEOUT_SECONDS
# is how long a job can sit CLAIMED before it's assumed abandoned (agent
# crash/network drop) and requeued; PRINT_JOB_MAX_ATTEMPTS is how many times
# a job is retried (requeue or failed print report) before it's marked
# FAILED for good. Left empty, both fall back to 60 and 3.
PRINT_JOB_CLAIM_TIMEOUT_SECONDS=60
PRINT_JOB_MAX_ATTEMPTS=3
