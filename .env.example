PORT=4000
NODE_ENV=production

# MongoDB Atlas production example:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/la-isla-cafe?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/la-isla-cafe

# Generate a long random value for production.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origins allowed by CORS. Use comma-separated values if needed.
CORS_ORIGIN=https://laislacafepicnic.com,https://www.laislacafepicnic.com

# API prefixes mounted by this backend. Use /api-filereport if the shared server
# routes that path to this app.
API_BASE_PATHS=/api,/api-filereport
