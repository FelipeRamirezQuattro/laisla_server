<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reserva confirmada</title>
  </head>
  <body style="margin:0;padding:0;background:#FBF6E2;color:#101A3A;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#FBF6E2;padding:28px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:640px;background:#FEF9E7;border:1px solid rgba(16,26,58,.16);border-radius:18px;overflow:hidden;">
            <tr>
              <td style="background:#2043A9;padding:28px 32px;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                  <tr>
                    <td>
                      <img src="{{logoUrl}}" alt="La Isla Cafe Picnic" height="56" style="height:56px;width:auto;display:block;" />
                    </td>
                    <td align="right" style="font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#FCA613;font-weight:700;">
                      Reserva confirmada
                    </td>
                  </tr>
                </table>
                <h1 style="margin:24px 0 8px;font-size:30px;line-height:1.15;color:#FFFFFF;">&iexcl;Todo listo, {{clientName}}!</h1>
                <p style="margin:0;color:rgba(255,255,255,.82);font-size:15px;line-height:1.6;">
                  Tu reserva qued&oacute; confirmada. Te esperamos en La Isla.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:30px 32px 8px;">
                <p style="margin:0 0 10px;color:rgba(16,26,58,.72);font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;">C&oacute;digo de confirmaci&oacute;n</p>
                <div style="background:#FCA613;border-radius:14px;padding:18px 20px;text-align:center;color:#101A3A;font-size:34px;font-weight:800;letter-spacing:.18em;">
                  {{confirmationCode}}
                </div>
              </td>
            </tr>
            <tr>
              <td style="padding:22px 32px 8px;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                  <tr>
                    <td style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:rgba(16,26,58,.72);font-size:14px;">Nombre</td>
                    <td align="right" style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:#101A3A;font-size:14px;font-weight:700;">{{clientName}}</td>
                  </tr>
                  <tr>
                    <td style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:rgba(16,26,58,.72);font-size:14px;">Fecha</td>
                    <td align="right" style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:#101A3A;font-size:14px;font-weight:700;">{{dateLabel}}</td>
                  </tr>
                  <tr>
                    <td style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:rgba(16,26,58,.72);font-size:14px;">Horario</td>
                    <td align="right" style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:#101A3A;font-size:14px;font-weight:700;">{{timeSlot}}</td>
                  </tr>
                  <tr>
                    <td style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:rgba(16,26,58,.72);font-size:14px;">Personas</td>
                    <td align="right" style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:#101A3A;font-size:14px;font-weight:700;">{{partySize}}</td>
                  </tr>
                  <tr>
                    <td style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:rgba(16,26,58,.72);font-size:14px;">Zona</td>
                    <td align="right" style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:#101A3A;font-size:14px;font-weight:700;">{{zoneLabel}}</td>
                  </tr>
                  {{#if tableLabel}}
                  <tr>
                    <td style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:rgba(16,26,58,.72);font-size:14px;">Mesa asignada</td>
                    <td align="right" style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:#101A3A;font-size:14px;font-weight:700;">{{tableLabel}}</td>
                  </tr>
                  {{/if}}
                  {{#if occasionLabel}}
                  <tr>
                    <td style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:rgba(16,26,58,.72);font-size:14px;">Ocasi&oacute;n especial</td>
                    <td align="right" style="padding:13px 0;border-bottom:1px solid rgba(16,26,58,.14);color:#101A3A;font-size:14px;font-weight:700;">{{occasionLabel}}</td>
                  </tr>
                  {{/if}}
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:24px 32px 34px;">
                <div style="background:rgba(252,166,19,.16);border-radius:14px;padding:18px 20px;color:#101A3A;font-size:14px;line-height:1.6;">
                  Presenta este c&oacute;digo cuando llegues. Si necesitas cancelar o ajustar tu reserva, responde este correo o escr&iacute;benos por WhatsApp.
                </div>
              </td>
            </tr>
          </table>
          <p style="max-width:640px;margin:18px auto 0;color:rgba(16,26,58,.6);font-size:12px;line-height:1.6;text-align:center;">
            La Isla &middot; Caf&eacute; Picnic &middot; Ibagu&eacute;, Tolima<br />
            {{contactEmail}} &middot; {{contactPhone}}
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
