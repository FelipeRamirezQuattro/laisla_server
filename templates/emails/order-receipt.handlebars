<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tu recibo</title>
  </head>
  <body style="margin:0;padding:0;background:#FBF6E2;color:#101A3A;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#FBF6E2;padding:28px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:640px;background:#FEF9E7;border:1px solid rgba(16,26,58,.16);border-radius:18px;overflow:hidden;">
            <tr>
              <td style="background:#2043A9;padding:28px 32px;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                  <tr>
                    <td>
                      <img src="{{logoUrl}}" alt="{{businessName}}" height="56" style="height:56px;width:auto;display:block;" />
                    </td>
                    <td align="right" style="font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#FCA613;font-weight:700;">
                      {{documentLegend}}
                    </td>
                  </tr>
                </table>
                <h1 style="margin:24px 0 8px;font-size:28px;line-height:1.15;color:#FFFFFF;">{{businessName}}</h1>
                <p style="margin:0;color:rgba(255,255,255,.82);font-size:14px;line-height:1.6;">
                  {{#if idNumber}}NIT {{idNumber}} &middot; {{/if}}{{date}} {{time}}
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:24px 32px 8px;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                  <tr>
                    <td style="padding:10px 0;border-bottom:1px solid rgba(16,26,58,.14);color:rgba(16,26,58,.72);font-size:13px;">No. de recibo</td>
                    <td align="right" style="padding:10px 0;border-bottom:1px solid rgba(16,26,58,.14);color:#101A3A;font-size:13px;font-weight:700;">{{saleNumber}}</td>
                  </tr>
                  <tr>
                    <td style="padding:10px 0;border-bottom:1px solid rgba(16,26,58,.14);color:rgba(16,26,58,.72);font-size:13px;">Mesa</td>
                    <td align="right" style="padding:10px 0;border-bottom:1px solid rgba(16,26,58,.14);color:#101A3A;font-size:13px;font-weight:700;">{{tableLabel}}</td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 32px 8px;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                  {{#each items}}
                  <tr>
                    <td colspan="2" style="padding:12px 0 0;color:#101A3A;font-size:14px;font-weight:700;">{{this.name}}</td>
                  </tr>
                  <tr>
                    <td style="padding:0 0 12px;border-bottom:1px solid rgba(16,26,58,.14);color:rgba(16,26,58,.72);font-size:13px;">{{this.detail}}</td>
                    <td align="right" style="padding:0 0 12px;border-bottom:1px solid rgba(16,26,58,.14);color:#101A3A;font-size:13px;font-weight:700;">{{this.total}}</td>
                  </tr>
                  {{/each}}
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:8px 32px 8px;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                  <tr>
                    <td style="padding:8px 0;color:rgba(16,26,58,.72);font-size:14px;">Subtotal</td>
                    <td align="right" style="padding:8px 0;color:#101A3A;font-size:14px;">{{subtotal}}</td>
                  </tr>
                  <tr>
                    <td style="padding:8px 0;color:#101A3A;font-size:18px;font-weight:800;">Total</td>
                    <td align="right" style="padding:8px 0;color:#101A3A;font-size:18px;font-weight:800;">{{total}}</td>
                  </tr>
                  <tr>
                    <td style="padding:8px 0;color:rgba(16,26,58,.72);font-size:14px;">Pago</td>
                    <td align="right" style="padding:8px 0;color:#101A3A;font-size:14px;font-weight:700;">{{paymentMethodLabel}}</td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:24px 32px 34px;">
                <div style="background:rgba(252,166,19,.16);border-radius:14px;padding:18px 20px;color:#101A3A;font-size:14px;line-height:1.6;">
                  &iexcl;Gracias por tu visita! Si tienes alguna pregunta sobre este recibo, responde este correo.
                </div>
              </td>
            </tr>
          </table>
          <p style="max-width:640px;margin:18px auto 0;color:rgba(16,26,58,.6);font-size:12px;line-height:1.6;text-align:center;">
            {{businessName}} &middot; Ibagu&eacute;, Tolima<br />
            {{#if phone}}Tel: {{phone}}{{/if}}{{#if social}} &middot; {{social}}{{/if}}
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
